{
  "version": 1,
  "label": "MassBattleFrame MCP 用户文档",
  "mode": "maintain",
  "code_paths": [
    "Source/MassBattleEditorMCP/**/*.h",
    "Source/MassBattleEditorMCP/**/*.cpp"
  ],
  "documentation": {
    "title": "MassBattleFrame MCP",
    "version_file": "MassBattleEditorMCP.uplugin",
    "source_language": "en",
    "languages": [
      "zh-CN",
      "en"
    ],
    "user_inputs": [
      "Source/MassBattleEditorMCP/Public/**/*.h"
    ],
    "output": "Saved/Documentation/Website",
    "translation_directory": "Docs/TranslationMemory"
  },
  "data": [
    {
      "name": "DocumentationTranslations",
      "fields": {
        "reviewed": {
          "type": "boolean"
        },
        "translated_source_hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "source_text": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "path": "Docs/TranslationMemory/zh-CN.json",
      "key": "id"
    }
  ]
}